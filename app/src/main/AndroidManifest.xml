<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <package android:name="com.android.settings" />
        <package android:name="com.oplus.settings" />
        <package android:name="com.coloros.settings" />
        <provider android:authorities="com.android.settings" />
        <provider android:authorities="com.oplus.settings" />
        <provider android:authorities="com.coloros.settings" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.cursor.item/contact" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <package android:name="com.android.contacts" />
        <package android:name="com.google.android.contacts" />
        <package android:name="com.mediatek.contacts" />
        <package android:name="com.android.dialer" />
        <package android:name="com.oplus.contacts" />
        <package android:name="com.coloros.contacts" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="sms" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="sms" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mms" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mmsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android-dir/mms-sms" />
        </intent>
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="com.android.mms" />
        <package android:name="com.android.messaging" />
        <package android:name="com.oplus.mms" />
        <package android:name="com.coloros.mms" />
        <package android:name="com.heytap.mms" />
        <package android:name="com.oneplus.mms" />
        <package android:name="com.oppo.mms" />
        <intent>
            <action android:name="action.nearme.note.textnote" />
        </intent>
        <package android:name="com.coloros.note" />
        <package android:name="com.oplus.note" />
        <package android:name="com.nearme.note" />
        <package android:name="com.oneplus.note" />
        <package android:name="gd.app.note" />
        <provider android:authorities="com.coloros.note.notesprovider" />
        <provider android:authorities="com.nearme.note" />
        <provider android:authorities="com.oplus.note.notesprovider" />
        <provider android:authorities="com.coloros.note" />
        <provider android:authorities="com.nearme.note.notesprovider" />
        <provider android:authorities="com.oplus.note" />
        <provider android:authorities="gd.app.note.search" />
        <intent>
            <action android:name="gd.app.note.VIEW_NOTE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <package android:name="com.google.android.documentsui" />
        <package android:name="com.android.documentsui" />
        <package android:name="com.coloros.filemanager" />
        <package android:name="com.oplus.filemanager" />
        <package android:name="com.oneplus.filemanager" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.cursor.item/event" />
        </intent>
        <package android:name="com.coloros.calendar" />
        <package android:name="com.oplus.calendar" />
        <package android:name="com.android.calendar" />
        <package android:name="com.google.android.calendar" />
        <package android:name="gd.app.calendar" />
        <provider android:authorities="gd.app.calendar.search" />
        <intent>
            <action android:name="gd.app.calendar.VIEW_EVENT" />
        </intent>
        <intent>
            <action android:name="gd.app.calendar.VIEW_TODO" />
        </intent>
    </queries>

    <application
        android:name=".QsbApplicationWrapper"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuickSearchBox">

        <activity
            android:name=".ui.activity.SearchHomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.search.action.GLOBAL_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
