<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/contact_call"
        android:layout_width="@dimen/search_contact_action_size"
        android:layout_height="@dimen/search_contact_action_size"
        android:background="@drawable/bg_search_icon_ripple"
        android:clickable="true"
        android:contentDescription="@string/search_contact_call"
        android:focusable="true"
        android:padding="@dimen/search_bar_icon_padding"
        android:scaleType="center"
        android:src="@drawable/ic_contact_call" />

    <ImageView
        android:id="@+id/contact_message"
        android:layout_width="@dimen/search_contact_action_size"
        android:layout_height="@dimen/search_contact_action_size"
        android:layout_marginStart="2dp"
        android:background="@drawable/bg_search_icon_ripple"
        android:clickable="true"
        android:contentDescription="@string/search_contact_message"
        android:focusable="true"
        android:padding="@dimen/search_bar_icon_padding"
        android:scaleType="center"
        android:src="@drawable/ic_contact_message" />
</LinearLayout>
