<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.QuickSearchBox" parent="Theme.COUI.Main.Light">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Translucent so live wallpaper frost can show when bake is unavailable.
             Dialer bake path still fills the window with an opaque blur drawable. -->
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="viewInflaterClass">com.coui.appcompat.theme.COUIComponentsViewInflater</item>
        <item name="couiSearchBarStyle">@style/Widget.COUI.COUISearchBar</item>
        <item name="couiColorCard">@color/search_category_card</item>
        <item name="couiColorCardBackground">@color/search_category_card</item>
        <item name="couiColorCardPressed">@color/search_category_card_pressed</item>
    </style>

    <style name="Theme.QuickSearchBox.NoAnimation" parent="Theme.QuickSearchBox">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
