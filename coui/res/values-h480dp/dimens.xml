    <dimen name="coui_alert_dialog_builder_content_max_height_with_adapter">240dp</dimen>
    <dimen name="coui_alert_dialog_builder_content_min_height">60dp</dimen>
    <dimen name="coui_alert_dialog_builder_title_scroll_max_height">160dp</dimen>
</resources>
