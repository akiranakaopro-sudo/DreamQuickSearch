<?xml version="1.0" encoding="utf-8"?>
<!-- COUI toolbar styles (monolith feature-split) -->
<resources>
    <style name="COUIAppBarSubtitleStyle">
            <item name="android:textAppearance">@style/textAppearanceLargestTitle</item>
            <item name="android:textSize">@dimen/coui_appbar_subtitle_text_size</item>
            <item name="android:textStyle">normal</item>
            <item name="android:textColor">?couiColorSecondNeutral</item>
        </style>
    <style name="COUICollapsedToolbarStyle">
            <item name="android:layout_width">match_parent</item>
            <item name="android:layout_height">@dimen/coui_appbar_title_toolbar_height</item>
            <item name="android:layout_marginTop">@dimen/coui_appbar_title_collapsed_margin_top</item>
            <item name="android:layout_marginBottom">@dimen/coui_appbar_title_collapsed_margin_bottom
            </item>
            <item name="android:layout_marginStart">@dimen/coui_appbar_title_collapsed_margin_start
            </item>
            <item name="android:layout_marginEnd">@dimen/coui_appbar_title_collapsed_margin_end</item>
            <item name="layout_collapseMode">pin</item>
            <item name="supportTitleTextAppearance">@style/textAppearanceSecondTitle</item>
        </style>
    <style name="COUICollapsingToolbarLayoutStyle">
            <item name="android:orientation">vertical</item>
            <item name="android:layout_width">match_parent</item>
            <item name="android:layout_height">@dimen/coui_appbar_title_expanded_height</item>
            <item name="collapsedTitleTextAppearance">@style/COUIAppbarTitleStyle.Collapsed</item>
            <item name="expandedTitleGravity">start|top</item>
            <item name="expandedTitleMarginBottom">@dimen/coui_appbar_title_expanded_margin_bottom
            </item>
            <item name="expandedTitleMarginEnd">@dimen/coui_appbar_title_expanded_margin_end</item>
            <item name="expandedTitleMarginStart">@dimen/coui_appbar_title_expanded_margin_start</item>
            <item name="expandedTitleMarginTop">@dimen/coui_appbar_title_expanded_margin_top</item>
            <item name="expandedTitleTextAppearance">@style/COUIAppbarTitleStyle.Expanded</item>
            <item name="layout_scrollFlags">scroll|exitUntilCollapsed|snap</item>
        </style>
    <style name="COUIToolBarInAppBarLayoutStyle">
            <item name="android:paddingTop">@dimen/toolbar_top_padding</item>
            <item name="android:paddingBottom">@dimen/toolbar_bottom_padding</item>
            <item name="android:layout_height">@dimen/toolbar_min_height</item>
        </style>
    <style name="Widget.COUI.CoreToolbar" parent="@android:style/Widget">
            <item name="android:textColor">?couiColorPrimaryNeutral</item>
            <item name="android:paddingLeft">@dimen/core_toolbar_normal_menu_padding_left</item>
            <item name="android:paddingRight">@dimen/core_toolbar_normal_menu_padding_right</item>
            <item name="android:minHeight">@dimen/core_toolbar_min_height</item>
            <item name="navigationContentDescription">@string/coui_toolbar_navigation_back</item>
        </style>
    <style name="Widget.COUI.Toolbar" parent="@android:style/Widget">
            <item name="android:textColor">?couiColorPrimaryNeutral</item>
            <item name="android:paddingLeft">@dimen/toolbar_normal_menu_padding_left</item>
            <item name="android:paddingRight">@dimen/toolbar_normal_menu_padding_right</item>
            <item name="android:minHeight">@dimen/toolbar_min_height</item>
            <item name="minTitleTextSize">16.0dp</item>
            <item name="navigationContentDescription">@string/coui_toolbar_navigation_back</item>
            <item name="supportButtonGravity">center_vertical</item>
            <item name="supportCollapseContentDescription">
                @string/support_abc_toolbar_collapse_description
            </item>
            <item name="supportCollapseIcon">?homeAsUpIndicator</item>
            <item name="supportContentInsetEnd">0.0dp</item>
            <item name="supportContentInsetStart">0.0dp</item>
            <item name="supportMaxButtonHeight">@dimen/toolbar_min_height</item>
            <item name="supportSubtitleTextAppearance">
                @style/TextAppearance.COUI.AppCompatSupport.Toolbar.SubTitle
            </item>
            <item name="supportTitleMarginBottom">1.0dp</item>
            <item name="supportTitleMarginTop">3.0dp</item>
            <item name="supportTitleMargins">0.0dp</item>
            <item name="supportTitleTextAppearance">
                @style/TextAppearance.COUI.AppCompatSupport.Toolbar.Title
            </item>
        </style>
    <style name="Widget.COUI.Toolbar.Panel" parent="@style/Widget.COUI.Toolbar">
            <item name="android:paddingTop">@dimen/toolbar_top_padding</item>
            <item name="android:paddingBottom">@dimen/toolbar_bottom_padding</item>
            <item name="android:layout_width">match_parent</item>
            <item name="android:layout_height">wrap_content</item>
            <item name="android:minHeight">@dimen/toolbar_min_height</item>
            <item name="supportButtonGravity">center_vertical</item>
            <item name="supportMaxButtonHeight">@dimen/toolbar_min_height</item>
            <item name="supportPanelStyle">true</item>
            <item name="supportTitleMarginBottom">0.0dp</item>
            <item name="supportTitleMarginTop">0.0dp</item>
            <item name="supportTitlePaddingBottom">12.0dp</item>
            <item name="supportTitlePaddingTop">12.0dp</item>
            <item name="supportTitleTextAppearance">
                @style/TextAppearance.COUI.AppCompatSupport.Toolbar.Title.Panel
            </item>
        </style>
</resources>
