<?xml version="1.0" encoding="utf-8"?>
<!-- COUI panel attrs (from decoded dump consolidation) -->
<resources>
    <attr name="couiBottomSheetDialogStyle" format="reference" />
    <attr name="couiDraggableVerticalLinearLayoutStyle" format="reference" />

    <declare-styleable name="COUIBottomSheetDialog">
        <attr name="couiHandleViewHasPressAnim" />
        <attr name="couiIsHandlePanel" />
        <attr name="couiPanelEdgeToEdge" />
        <attr name="couiPanelPaddingBottom" />
        <attr name="couiPanelSupportExitBlockingAnimation" />
        <attr name="couiShowMaxHeight" />
        <attr name="panelBackground" />
        <attr name="panelBackgroundTintColor" />
        <attr name="panelDragViewIcon" />
        <attr name="panelDragViewTintColor" />
    </declare-styleable>

    <declare-styleable name="COUIDraggableVerticalLinearLayout">
        <attr name="dragViewIcon" />
        <attr name="dragViewTintColor" />
        <attr name="hasShadowNinePatchDrawable" />
    </declare-styleable>

    <declare-styleable name="COUIPanelPercentFrameLayout">
        <attr name="maxPanelHeight" />
    </declare-styleable>

    <declare-styleable name="IgnoreWindowInsetsFrameLayout">
        <attr name="ignoreWindowInsetsBottom" />
        <attr name="ignoreWindowInsetsLeft" />
        <attr name="ignoreWindowInsetsRight" />
        <attr name="ignoreWindowInsetsTop" />
    </declare-styleable>
</resources>
