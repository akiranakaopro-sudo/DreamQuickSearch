<?xml version="1.0" encoding="utf-8"?>
<!-- COUI seekbar styles (monolith feature-split) -->
<resources>
    <style name="COUIIntentSeekBar" parent="@style/COUISeekBar">
            <item name="couiSeekBarBackgroundHeight">4dp</item>
            <item name="couiSeekBarProgressHeight">4dp</item>
            <item name="couiSeekBarSecondaryProgressColor">
                @color/coui_seekbar_secondary_progress_color
            </item>
            <item name="couiSeekBarThumbColor">@color/coui_seekbar_progress_selector</item>
        </style>
    <style name="COUIIntentSeekBar.Dark" parent="@style/COUISeekBar.Dark">
            <item name="couiSeekBarBackgroundHeight">4dp</item>
            <item name="couiSeekBarProgressHeight">4dp</item>
            <item name="couiSeekBarSecondaryProgressColor">
                @color/coui_seekbar_secondary_progress_color
            </item>
            <item name="couiSeekBarThumbColor">@color/coui_seekbar_progress_selector</item>
        </style>
    <style name="COUIProgressHorizontal">
            <item name="android:max">100</item>
            <item name="android:progress">0</item>
            <item name="android:indeterminateOnly">false</item>
            <item name="couiHorizontalProgressBarBackgroundColor">
                @color/coui_progressbar_background_selector
            </item>
            <item name="couiHorizontalProgressBarProgressColor">
                @color/coui_progressbar_progress_selector
            </item>
        </style>
    <style name="COUISectionSeekBar" parent="@style/COUISeekBar">
            <item name="couiSeekBarPhysicsEnable">false</item>
        </style>
    <style name="COUISectionSeekBar.Dark" parent="@style/COUISeekBar.Dark">
            <item name="couiSeekBarPhysicsEnable">false</item>
        </style>
    <style name="COUISeekBar">
            <item name="couiSeekBarAdaptiveVibrator">true</item>
            <item name="couiSeekBarBackgroundColor">@color/coui_seekbar_background_selector</item>
            <item name="couiSeekBarBackgroundHeight">@dimen/coui_seekbar_background_height</item>
            <item name="couiSeekBarDeformation">true</item>
            <item name="couiSeekBarMinHeight">36.0dp</item>
            <item name="couiSeekBarPhysicsEnable">true</item>
            <!-- Leapy added 2026-08-14: Decoded OPPO progress ColorStateList
                 (enabled theme / disabled couiColorDisable). -->
            <item name="couiSeekBarProgressColor">@color/coui_seekbar_progress_selector</item>
            <item name="couiSeekBarProgressFull">false</item>
            <item name="couiSeekBarProgressHeight">@dimen/coui_seekbar_progress_height</item>
            <item name="couiSeekBarProgressScaleRadius">@dimen/coui_seekbar_progress_scale_radius</item>
            <item name="couiSeekBarShowGlitterEffect">true</item>
            <item name="couiSeekBarShowProgress">true</item>
            <item name="couiSeekBarShowThumb">true</item>
            <item name="couiSeekBarStartMiddle">false</item>
            <item name="couiSeekBarThumbColor">@color/coui_seekbar_thumb_selector</item>
            <item name="couiSeekBarThumbOutRadius">@dimen/coui_seekbar_thumb_out_radius</item>
            <item name="couiSeekBarThumbShadowSize">4.0dp</item>
        </style>
    <style name="COUISeekBar.Dark" parent="@style/COUISeekBar">
            <item name="couiSeekBarBackgroundColor">@color/coui_seekbar_background_selector_dark</item>
            <item name="couiSeekBarProgressColor">@color/coui_seekbar_progress_selector_dark</item>
        </style>
    <style name="COUIVerticalSeekBar">
            <item name="couiVerticalSeekBarAdaptiveVibrator">true</item>
            <item name="couiVerticalSeekBarBackgroundColor">@color/coui_seekbar_background_selector
            </item>
            <item name="couiVerticalSeekBarBackgroundRadius">@dimen/coui_seekbar_background_radius
            </item>
            <item name="couiVerticalSeekBarMinWidth">36.0dp</item>
            <item name="couiVerticalSeekBarPhysicsEnable">true</item>
            <item name="couiVerticalSeekBarProgressColor">@color/coui_seekbar_progress_selector</item>
            <item name="couiVerticalSeekBarProgressFull">false</item>
            <item name="couiVerticalSeekBarProgressPaddingVertical">
                @dimen/coui_vertical_seekbar_progress_padding_vertical
            </item>
            <item name="couiVerticalSeekBarProgressRadius">@dimen/coui_seekbar_progress_radius</item>
            <item name="couiVerticalSeekBarProgressScaleRadius">
                @dimen/coui_seekbar_progress_scale_radius
            </item>
            <item name="couiVerticalSeekBarShowProgress">true</item>
            <item name="couiVerticalSeekBarShowThumb">true</item>
            <item name="couiVerticalSeekBarThumbColor">@color/coui_seekbar_progress_selector</item>
            <item name="couiVerticalSeekBarThumbOutRadius">@dimen/coui_seekbar_thumb_out_radius</item>
        </style>
    <style name="COUIVerticalSeekBar.Dark" parent="@style/COUIVerticalSeekBar">
