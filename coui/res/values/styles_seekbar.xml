        </style>
    <style name="Widget.COUI.COUICompProgressIndicator.TipsTextView" parent="@android:style/Widget">
            <item name="android:textAppearance">@style/couiTextBodyS</item>
            <item name="android:textColor">?couiColorLabelSecondary</item>
            <item name="android:ellipsize">end</item>
            <item name="android:focusable">true</item>
