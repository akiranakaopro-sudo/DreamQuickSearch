<?xml version="1.0" encoding="utf-8"?>
<!-- COUI lockview styles (from decoded dump consolidation) -->
<resources>
    <style name="Widget.COUI.COUILockPatternView" parent="@android:style/Widget">
            <item name="android:paddingTop">@dimen/coui_lock_pattern_view_vertical_padding</item>
            <item name="android:paddingBottom">@dimen/coui_lock_pattern_view_vertical_padding</item>
            <item name="android:paddingStart">@dimen/coui_lock_pattern_view_horizontal_padding</item>
            <item name="android:paddingEnd">@dimen/coui_lock_pattern_view_horizontal_padding</item>
            <item name="couiErrorColor">@color/coui_lock_pattern_error_color</item>
            <item name="couiOuterCircleMaxAlpha">@dimen/coui_lock_pattern_outer_circle_max_alpha</item>
            <item name="couiPathColor">@color/coui_lock_pattern_path_color</item>
            <item name="couiRegularColor">@color/coui_lock_pattern_dot_color</item>
            <item name="couiSuccessColor">@color/coui_lock_pattern_success_color</item>
        </style>
    <style name="Widget.COUI.COUILockPatternView.Dark" parent="@style/Widget.COUI.COUILockPatternView">
            <item name="couiErrorColor">@color/coui_lock_pattern_error_dark_color</item>
            <item name="couiOuterCircleMaxAlpha">@dimen/coui_lock_pattern_outer_circle_max_dark_alpha</item>
            <item name="couiPathColor">@color/coui_lock_pattern_path_dark_color</item>
            <item name="couiRegularColor">@color/coui_lock_pattern_dot_dark_color</item>
            <item name="couiSuccessColor">@color/coui_lock_pattern_success_dark_color</item>
        </style>
    <style name="Widget.COUI.COUINumericKeyboard" parent="@android:style/Widget">
            <item name="android:paddingTop">@dimen/coui_numeric_keyboard_view_vertical_padding</item>
            <item name="android:paddingBottom">@dimen/coui_numeric_keyboard_view_vertical_padding</item>
            <item name="android:paddingStart">@dimen/coui_numeric_keyboard_view_horizontal_padding</item>
            <item name="android:paddingEnd">@dimen/coui_numeric_keyboard_view_horizontal_padding</item>
            <item name="couiCircleMaxAlpha">0.12</item>
            <item name="couiLetterColor">@color/coui_numeric_keyboard_letter_color</item>
            <item name="couiLineColor">@color/coui_numeric_keyboard_line_color</item>
            <item name="couiNumPressColor">@color/coui_numeric_keyboard_number_press_color</item>
            <item name="couiNumberColor">@color/coui_numeric_keyboard_number_color</item>
            <item name="couiNumberTextSize">@dimen/number_keyboard_number_size</item>
            <item name="couiWordTextNormalColor">@color/coui_numeric_keyboard_word_text_normal_color</item>
            <item name="couiWordTextPressColor">@color/coui_numeric_keyboard_word_text_press_color</item>
        </style>
    <style name="Widget.COUI.COUINumericKeyboard.Dark" parent="@style/Widget.COUI.COUINumericKeyboard">
            <item name="couiCircleMaxAlpha">@dimen/coui_numeric_keyboard_dark_circle_max_alpha</item>
            <item name="couiLetterColor">@color/coui_numeric_keyboard_dark_letter_color</item>
            <item name="couiLineColor">@color/coui_numeric_keyboard_dark_line_color</item>
            <item name="couiNumPressColor">@color/coui_numeric_keyboard_dark_number_press_color</item>
            <item name="couiNumberColor">@color/coui_numeric_keyboard_dark_number_color</item>
            <item name="couiWordTextNormalColor">@color/coui_numeric_keyboard_dark_word_text_normal_color</item>
            <item name="couiWordTextPressColor">?attr/couiColorHintNeutral</item>
        </style>
    <style name="Widget.COUI.COUINumericKeyboard.Dark.Dark" parent="@style/Widget.COUI.COUINumericKeyboard.Dark">
            <item name="couiCircleMaxAlpha">@dimen/coui_numeric_keyboard_dark_circle_max_dark_alpha</item>
            <item name="couiLetterColor">@color/coui_numeric_keyboard_dark_letter_dark_color</item>
            <item name="couiLineColor">@color/coui_numeric_keyboard_dark_line_dark_color</item>
            <item name="couiNumPressColor">@color/coui_numeric_keyboard_dark_number_press_dark_color</item>
            <item name="couiNumberColor">@color/coui_color_label_primary_dark</item>
            <item name="couiWordTextPressColor">@color/coui_numeric_keyboard_dark_word_text_press_dark_color</item>
        </style>
    <style name="Widget.COUI.COUISimpleLock" parent="@android:style/Widget">
            <item name="couiFilledRectangleIconDrawable">@drawable/coui_simple_lock_filled_rectangle_icon</item>
            <item name="couiOutLinedRectangleIconDrawable">@drawable/coui_simple_lock_outlined_rectangle_icon</item>
            <item name="couiRectanglePadding">10dp</item>
        </style>
    <style name="Widget.COUI.COUISimpleLock.Dark" parent="@style/Widget.COUI.COUISimpleLock">
            <item name="couiFilledRectangleIconDrawable">@drawable/coui_simple_lock_filled_rectangle_icon_dark</item>
            <item name="couiOutLinedRectangleIconDrawable">@drawable/coui_simple_lock_outlined_rectangle_icon_dark</item>
        </style>
</resources>
