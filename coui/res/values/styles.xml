<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.CardView" parent="@android:style/Widget">
        <item name="cardCornerRadius">@dimen/cardview_default_radius</item>
        <item name="cardElevation">@dimen/cardview_default_elevation</item>
        <item name="cardMaxElevation">@dimen/cardview_default_elevation</item>
        <item name="cardPreventCornerOverlap">true</item>
        <item name="cardUseCompatPadding">false</item>
    </style>

    <style name="CardView" parent="@style/Base.CardView">
        <item name="cardBackgroundColor">?android:colorBackgroundFloating</item>
    </style>

    <style name="CardView.Dark" parent="@style/CardView">
        <item name="cardBackgroundColor">@color/cardview_dark_background</item>
    </style>

    <style name="CardView.Light" parent="@style/CardView">
        <item name="cardBackgroundColor">@color/cardview_light_background</item>
    </style>

    <!-- App Bars And Toolbars -->
    

    <style name="Widget.AppCompatSupport.ListPopupWindow" parent="@style/Widget.AppCompat.ListPopupWindow" />

    

    

    

    <style name="COUIAppbarTitleStyle">
        <item name="android:textSize" tools:ignore="SpUsage">22dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?couiColorPrimaryNeutral</item>
        <item name="android:singleLine">true</item>
        <!-- Temporarily disabled 2026-07-16: <item name="android:fontFamily">sans-serif-medium</item> -->
        <item name="android:textAlignment">viewStart</item>
    </style>

    <style name="COUIAppbarTitleStyle.Collapsed" parent="@style/COUIAppbarTitleStyle">
        <item name="android:textSize">@dimen/coui_appbar_title_collapsed_text_size</item>
    </style>

    <style name="COUIAppbarTitleStyle.Expanded" parent="@style/COUIAppbarTitleStyle">
        <item name="android:textSize">@dimen/coui_appbar_title_expanded_text_size</item>
        <!-- Temporarily disabled 2026-07-16: <item name="android:fontFamily">sans-serif-semibold</item> -->
        <item name="lineSpacingMultiplier">1.4</item>
    </style>

    

    

    <style name="COUIMenuItemStyle" parent="@style/couiTextAppearanceSmallButton">
        <item name="android:textSize">16.0dp</item>
