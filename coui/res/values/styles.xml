        <item name="android:background">@null</item>
        <item name="android:paddingLeft">@dimen/coui_toolbar_menu_bg_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/coui_toolbar_menu_bg_padding_vertical</item>
        <item name="android:paddingRight">@dimen/coui_toolbar_menu_bg_padding_horizontal</item>
        <item name="android:paddingBottom">@dimen/coui_toolbar_menu_bg_padding_vertical</item>
        <item name="android:scaleType">center</item>
        <item name="android:maxWidth">@dimen/coui_action_bar_menu_max_width</item>
        <item name="android:maxLines">2</item>
        <item name="android:singleLine">false</item>
        <item name="android:textAllCaps">@bool/coui_config_actionMenuItemAllCaps</item>
    </style>

    

    <style name="COUIWindowTitle">
        <item name="android:textAppearance">@style/TextAppearance.COUI.WindowTitle</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:shadowColor">#bb000000</item>
