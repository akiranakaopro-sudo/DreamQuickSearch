            <!-- Temporarily disabled 2026-07-16: <item name="android:fontFamily">sans-serif-medium</item> -->
        </style>
    <style name="couiTextAppearanceTag" parent="@style/couiTextAppearance">
            <item name="android:textSize">10.0sp</item>
            <item name="android:lineSpacingMultiplier">@dimen/coui_spacing_multiplier_tag</item>
            <!-- Temporarily disabled 2026-07-16: <item name="android:fontFamily">sans-serif-medium</item> -->
        </style>
    <style name="couiTextAppearanceTinyHeadline1" parent="@style/couiTextAppearance">
            <item name="android:textSize">20.0sp</item>
            <item name="android:textStyle">bold</item>
            <!-- Temporarily disabled 2026-07-16: <item name="android:fontFamily">sans-serif-semibold</item> -->
        </style>
    <style name="couiTextAppearanceTinyHeadline2" parent="@style/couiTextAppearance">
            <item name="android:textSize">18.0sp</item>
            <!-- Temporarily disabled 2026-07-16: <item name="android:fontFamily">sans-serif-medium</item> -->
        </style>
    <style name="couiTextAppearanceTinyHeadline3" parent="@style/couiTextAppearance">
            <item name="android:textSize">20.0sp</item>
