        </style>
    <style name="couiTextAppearanceHeadline3" parent="@style/couiTextAppearance">
            <item name="android:textSize">24.0sp</item>
            <item name="android:lineSpacingMultiplier">@dimen/coui_spacing_multiplier_display_xs</item>
            <item name="android:textFontWeight">600</item>
        </style>
    <style name="couiTextAppearanceHeadline4" parent="@style/couiTextAppearance">
