<?xml version="1.0" encoding="utf-8"?>
<!-- COUI text styles (monolith feature-split) -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="couiTextAppearance" parent="@android:style/TextAppearance">
            <item name="android:textStyle">normal</item>
            <item name="android:textAllCaps">false</item>
            <!-- Temporarily disabled 2026-07-16: <item name="android:fontFamily">sans-serif</item> -->
            <item name="android:elegantTextHeight">@bool/coui_support_elegant_text_height</item>
        </style>
    <style name="couiTextAppearanceArticleBody" parent="@style/couiTextAppearance">
            <item name="android:textSize">14.0sp</item>
            <item name="android:lineSpacingMultiplier">@dimen/coui_spacing_multiplier_body_s</item>
        </style>
    <style name="couiTextAppearanceBody" parent="@style/couiTextAppearance">
            <item name="android:textSize">14.0sp</item>
            <item name="android:lineSpacingMultiplier">@dimen/coui_spacing_multiplier_body_m</item>
        </style>
