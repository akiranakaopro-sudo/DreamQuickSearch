<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@id/radio_on"
        android:drawable="@drawable/coui_btn_radio_on"
        android:state_checked="true"
        android:state_enabled="true" />
    <item
        android:id="@id/radio_off"
        android:drawable="@drawable/coui_btn_radio_off"
        android:state_checked="false"
        android:state_enabled="true" />
    <item
        android:drawable="@drawable/coui_btn_radio_on_disabled"
        android:state_checked="true"
        android:state_enabled="false" />
    <item
        android:drawable="@drawable/coui_btn_radio_off_disabled"
        android:state_checked="false"
        android:state_enabled="false" />
    <transition
        android:drawable="@drawable/coui_btn_radio_on_to_off_animation"
        android:fromId="@id/radio_on"
        android:toId="@id/radio_off" />
    <transition
        android:drawable="@drawable/coui_btn_radio_off_to_on_animation"
        android:fromId="@id/radio_off"
        android:toId="@id/radio_on" />
</animated-selector>
