<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@id/main_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/coui_alert_dialog_item_background"
        android:forceDarkAllowed="false"
        android:gravity="center"
        android:minHeight="@dimen/alert_dialog_list_item_min_height"
        android:orientation="vertical"
        android:paddingStart="@dimen/coui_bottom_alert_dialog_horizontal_button_margin_default"
        android:paddingTop="@dimen/alert_dialog_list_item_padding_top"
        android:paddingEnd="@dimen/coui_bottom_alert_dialog_horizontal_button_margin_default"
        android:paddingBottom="@dimen/alert_dialog_list_item_padding_bottom">

        <TextView
            android:id="@android:id/text1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="?couiTextAppearanceHeadline6"
            android:textColor="?couiColorPrimaryTextOnPopup" />

        <TextView
            android:id="@id/summary_text2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center|top"
            android:lineSpacingMultiplier="1.15"
            android:paddingTop="@dimen/coui_option_dialog_listview_text2_padding_top"
            android:textColor="?couiColorSecondNeutral"
            android:textSize="@dimen/coui_alert_dialog_summary_text_size" />
    </LinearLayout>

    <ImageView
        android:id="@id/item_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/coui_list_divider_height"
        android:layout_marginHorizontal="@dimen/coui_bottom_alert_dialog_horizontal_button_margin_default"
        android:background="?couiColorDivider"
        android:forceDarkAllowed="false"
        android:visibility="gone" />
</LinearLayout>
