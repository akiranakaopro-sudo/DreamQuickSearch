<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:coui="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pickers"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:gravity="center"
    android:layoutDirection="ltr"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/coui_number_picker_view_padding_vertical">

    <com.coui.appcompat.picker.COUINumberPicker
        android:id="@+id/year"
        android:layout_width="@dimen/coui_datepicker_width_year"
        android:layout_height="@dimen/coui_datepicker_height"
        android:focusable="true"
        android:focusableInTouchMode="true"
        coui:couiIsDrawBackground="false"
        coui:couiPickerVisualWidth="@dimen/coui_datepicker_width_year" />

    <com.coui.appcompat.picker.COUINumberPicker
        android:id="@+id/month"
        android:layout_width="@dimen/coui_datepicker_width_month"
        android:layout_height="@dimen/coui_datepicker_height"
        android:focusable="true"
        android:focusableInTouchMode="true"
        coui:couiIsDrawBackground="false" />

    <com.coui.appcompat.picker.COUINumberPicker
        android:id="@+id/day"
        android:layout_width="@dimen/coui_number_picker_width_small"
        android:layout_height="@dimen/coui_datepicker_height"
        android:focusable="true"
        android:focusableInTouchMode="true"
        coui:couiIsDrawBackground="false"
        coui:couiPickerVisualWidth="@dimen/coui_number_picker_width_small" />
</LinearLayout>
